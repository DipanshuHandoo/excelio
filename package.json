{
  "name": "@dipanshuhandoo/excelio",
  "version": "1.0.0",
  "description": "Excel XLSX reading and generation for Node.js with streaming writes, configurable worker-thread offloading, multi-sheet workbooks, and row validation.",
  "license": "MIT",
  "author": "DipanshuHandoo",
  "keywords": ["excel", "xlsx", "exceljs", "json", "streaming", "worker-threads", "import", "export"],
  "homepage": "https://github.com/DipanshuHandoo/excelio#readme",
  "bugs": { "url": "https://github.com/DipanshuHandoo/excelio/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/DipanshuHandoo/excelio.git" },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.cts", "default": "./dist/cjs/index.cjs" }
    },
    "./min": {
      "import": { "types": "./dist/esm-min/index.d.ts", "default": "./dist/esm-min/index.js" },
      "require": { "types": "./dist/cjs-min/index.d.cts", "default": "./dist/cjs-min/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:min": "node scripts/build.mjs --min",
    "test": "node src/__tests__/smoke.test.js",
    "test:perf": "node src/__tests__/perf.test.js",
    "examples": "node scripts/run-examples.mjs",
    "test:types": "tsc --noEmit --strict --module nodenext --target es2022 test/types/consumer.mts test/types/consumer.cts",
    "test:package": "node scripts/check-package.mjs",
    "pack:check": "node scripts/check-package.mjs --list",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify": "node scripts/verify.mjs",
    "publish:dry": "npm publish --dry-run --access public --registry https://registry.npmjs.org/",
    "publish:dry-run": "npm run publish:dry",
    "publish:public": "npm publish --access public --registry https://registry.npmjs.org/",
    "release": "npm run publish:public",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": { "exceljs": "^4.4.0" },
  "devDependencies": { "@types/node": "^22.0.0", "esbuild": "^0.28.2", "typescript": "^7.0.2" }
}